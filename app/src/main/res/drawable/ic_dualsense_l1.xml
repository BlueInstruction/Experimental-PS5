<?xml version="1.0" encoding="utf-8"?>
<!-- PX5 DualSense: L1/L2 Shoulder + Trigger — Vector Drawable -->
<!-- Curved shoulder button shape -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60dp"
    android:height="32dp"
    android:viewportWidth="60"
    android:viewportHeight="32">

    <!-- L1 (top, smaller) -->
    <path
        android:pathData="M5,12 L25,12 L25,4 C15,4 8,7 5,12 Z"
        android:fillColor="#1A1A2E"
        android:fillAlpha="0.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4" />

    <!-- L2 (bottom, larger, trigger) -->
    <path
        android:pathData="M5,14 L30,14 L30,4 C18,4 9,8 5,14 Z"
        android:fillColor="#0A0A15"
        android:fillAlpha="0.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.3" />

    <!-- Labels -->
    <path
        android:pathData="M12,9 L14,9"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.5" />

</vector>

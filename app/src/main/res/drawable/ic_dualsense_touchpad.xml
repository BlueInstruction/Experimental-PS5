<?xml version="1.0" encoding="utf-8"?>
<!-- PX5 DualSense: Touchpad — Vector Drawable -->
<!-- Wide touchpad rectangle -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="40dp"
    android:viewportWidth="120"
    android:viewportHeight="40">

    <!-- Touchpad body -->
    <path
        android:pathData="M4,4 L116,4 L116,36 L4,36 Z"
        android:fillColor="#0A0A15"
        android:fillAlpha="0.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.3" />

    <!-- Touch indicator (two dots) -->
    <path
        android:pathData="M50,20m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0"
        android:fillColor="#0066FF"
        android:fillAlpha="0.4" />

    <path
        android:pathData="M70,20m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0"
        android:fillColor="#0066FF"
        android:fillAlpha="0.2" />

</vector>

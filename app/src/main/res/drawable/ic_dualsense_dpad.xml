<?xml version="1.0" encoding="utf-8"?>
<!-- PX5 DualSense: D-Pad — Vector Drawable -->
<!-- Plus-shaped directional pad with 4 directions -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Background circle (subtle) -->
    <path
        android:pathData="M48,48m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1"
        android:strokeAlpha="0.15" />

    <!-- D-Pad cross shape -->
    <path
        android:pathData="M38,20 L58,20 L58,38 L76,38 L76,58 L58,58 L58,76 L38,76 L38,58 L20,58 L20,38 L38,38 Z"
        android:fillColor="#1A1A2E"
        android:fillAlpha="0.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeAlpha="0.4" />

    <!-- Up arrow -->
    <path
        android:pathData="M48,26 L44,32 L52,32 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5" />

    <!-- Down arrow -->
    <path
        android:pathData="M48,70 L44,64 L52,64 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5" />

    <!-- Left arrow -->
    <path
        android:pathData="M26,48 L32,44 L32,52 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5" />

    <!-- Right arrow -->
    <path
        android:pathData="M70,48 L64,44 L64,52 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5" />

</vector>

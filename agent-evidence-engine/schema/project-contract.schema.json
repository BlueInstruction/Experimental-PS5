{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Contract",
  "description": "Machine-readable contract defining how a project is built, installed, launched, and validated",
  "type": "object",
  "required": ["version", "project", "probes", "policy"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "package": { "type": "string" },
        "activity": { "type": "string" },
        "abi": { "type": "string" },
        "min_sdk": { "type": "integer" },
        "target_sdk": { "type": "integer" }
      }
    },
    "components": {
      "type": "array",
      "items": { "type": "string" }
    },
    "probes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy": {
      "type": "object",
      "required": ["fail_on"],
      "properties": {
        "fail_on": {
          "type": "array",
          "items": { "enum": ["P0", "P1", "P2", "P3"] }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "logcat": { "type": "boolean" },
        "native_logs": { "type": "boolean" },
        "probe_results": { "type": "boolean" }
      }
    }
  }
}

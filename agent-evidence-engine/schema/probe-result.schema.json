{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probe Result",
  "description": "Structured output from a single probe execution",
  "type": "object",
  "required": ["probe_id", "status", "evidence"],
  "properties": {
    "probe_id": { "type": "string" },
    "status": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "SKIPPED"] },
    "severity": { "enum": ["P0", "P1", "P2", "P3", "NONE"] },
    "component": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "key": { "type": "string" },
          "value": {}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "duration_ms": { "type": "number" }
  }
}

+#if defined(__ANDROID__)
+  // Bionic removed ::valloc; page-aligned posix_memalign is equivalent.
+  void* ptr = nullptr;
+  if (posix_memalign(&ptr, static_cast<size_t>(getpagesize()), size) != 0) {
+    return nullptr;
+  }
+  return ptr;
+#else
   return ::valloc(size);
+#endif
